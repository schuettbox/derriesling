# ── Neon Postgres ────────────────────────────────────────────────
# Aus dem Neon-Dashboard: Connection String (Pooled connection).
# In Vercel unter Project → Settings → Environment Variables setzen.
DATABASE_URL="postgres://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ── Sitzung / Auth ───────────────────────────────────────────────
# Ein langer, zufälliger String. Erzeugen z.B. mit:
#   openssl rand -base64 32
AUTH_SECRET="bitte-durch-einen-langen-zufallswert-ersetzen"

# ── E-Mail (optional, für echten Versand an Produzenten) ─────────
# Ohne diese Werte werden Bestellungen/Einladungen nur in der DB
# gespeichert (Konsolen-Log). Mit Resend-Key gehen echte Mails raus.
RESEND_API_KEY=""
MAIL_FROM="DerRiesling <post@derriesling.ch>"
